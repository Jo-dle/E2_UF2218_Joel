<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="coches">
        <xs:complexType>
            <xs:sequence>
                <!--empezamos las validación de los campos en el documento xml-->
                <xs:element name="coche" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="marca" type="xs:string"/>
                            <xs:element name="modelo" type="xs:string"/>
                            <xs:element name="puertas">
                                <xs:simpleType>
                                    <!--limitamos la cantidad de puertas-->
                                    <xs:restriction base="xs:integer">
                                        <xs:minInclusive value="2"/>
                                        <xs:maxInclusive value="5"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="color" type="xs:string"/>
                            <xs:element name="precio">
                                <xs:complexType>
                                    <xs:simpleContent>
                                        <xs:extension base="xs:integer">
                                            <!--requerimos el campo de venta y validamos las tres opciones -->
                                            <xs:attribute name="venta" use="required">
                                                <xs:simpleType>
                                                        <xs:restriction base="xs:string">
                                                        <xs:enumeration value="nuevo"/>
                                                        <xs:enumeration value="ocasión"/>
                                                        <xs:enumeration value="segunda mano"/>
                                                    </xs:restriction>
                                                </xs:simpleType>
                                            </xs:attribute>
                                        </xs:extension>
                                    </xs:simpleContent>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <!--Obligamos el patrón de la matrícual-->
                        <xs:attribute name="matricula" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="[0-9]{4}[A-Z]{3}"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <!--Aplicamos la restricción de "Unica" a las matrículas para que no se puedan repetir-->
        <xs:unique name="matriculaUnica">
            <xs:selector xpath="coche"/>
            <xs:field xpath="@matricula"/>
        </xs:unique>

    </xs:element>
</xs:schema>